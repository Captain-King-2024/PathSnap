{
  "model_name": "RandomForest",
  "model_dir": "models/RandomForest",
  "feature_names": [
    "distance_m",
    "distance_rank",
    "projection_fraction",
    "arc_length_m",
    "heading_cosine",
    "heading_available",
    "previous_step_m",
    "previous_dt_s",
    "previous_speed_mps",
    "gap_over_5s",
    "start_out_degree",
    "end_in_degree"
  ],
  "label_strategy": "pointwise_route_overlap",
  "candidate_radius_m": 100,
  "max_candidates_k": 8,
  "default_params": {
    "n_estimators": 300,
    "max_depth": null,
    "min_samples_leaf": 4,
    "max_features": "sqrt",
    "class_weight": "balanced",
    "n_jobs": -1,
    "random_state": 42,
    "oob_score": true
  },
  "cv_folds": 5,
  "cv_group_strategy": "trip",
  "seed": 42
}
