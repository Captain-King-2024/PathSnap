{
  "model_name": "LightGBM",
  "family": "Boosting (gradient-boosted decision trees)",
  "seed": 42,
  "n_splits": 5,
  "num_boost_round": 300,
  "params": {
    "objective": "binary",
    "metric": "binary_logloss",
    "learning_rate": 0.05,
    "num_leaves": 63,
    "max_depth": -1,
    "min_child_samples": 50,
    "feature_fraction": 0.9,
    "bagging_fraction": 0.8,
    "bagging_freq": 1,
    "lambda_l1": 0.0,
    "lambda_l2": 1.0,
    "num_threads": 0,
    "verbosity": -1,
    "deterministic": true,
    "force_row_wise": true
  }
}
