{
  "objective": "maximise mean observation-level top-1 accuracy over group-aware CV folds (training trips only)",
  "sampler": "Optuna TPE (Bayesian, multivariate)",
  "pruner": "MedianPruner (n_startup_trials=5), reports running mean top-1 after each fold",
  "space": {
    "num_leaves":        {"type": "int",   "low": 15,    "high": 255, "log": true},
    "learning_rate":     {"type": "float", "low": 0.02,  "high": 0.2, "log": true},
    "num_boost_round":   {"type": "int",   "low": 100,   "high": 500, "step": 50},
    "min_child_samples": {"type": "int",   "low": 10,    "high": 300, "log": true},
    "feature_fraction":  {"type": "float", "low": 0.5,   "high": 1.0},
    "bagging_fraction":  {"type": "float", "low": 0.5,   "high": 1.0},
    "lambda_l1":         {"type": "float", "low": 1e-8,  "high": 10.0, "log": true},
    "lambda_l2":         {"type": "float", "low": 1e-8,  "high": 10.0, "log": true}
  }
}
